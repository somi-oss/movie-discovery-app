generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wishlist {
  id          Int      @id @default(autoincrement())
  movieId     Int      @unique
  title       String
  posterPath  String?
  releaseYear String?
  rating      Float?
  addedAt     DateTime @default(now())
}